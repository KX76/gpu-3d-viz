{
  "name": "gpu-3d-viz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "open": "open dist/index.html",
    "test:offline": "pnpm build && node --test tests/offline.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm test && pnpm test:offline"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "description": "Offline 3D GPU architecture explorer with schematic instruction flows",
  "packageManager": "pnpm@11.19.0"
}
